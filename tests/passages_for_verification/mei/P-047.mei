    <body>
      <mdiv>
        <score>
          <scoreDef key.mode="major" key.pname="c" keysig="0" meter.count="4" meter.sym="common" meter.unit="4" optimize="false" xml:id="scoreDef_01">
            <staffGrp bar.thru="true" decls="#instrVoice_1" doxml.id="d28e29" symbol="brace" xml:id="staffGrp_01">
              <staffDef clef.line="2" clef.shape="G" decls="#upper" lines="5" n="1" xml:id="staffDef_P1"/>
              <staffDef clef.line="4" clef.shape="F" decls="#lower" lines="5" n="2" xml:id="staffDef_P2"/>
            </staffGrp>
          </scoreDef>
          <section>
            <measure facs="#zoneOf_measure1" n="1" xml:id="m1_k545_001">
                <tempo doxml.id="d28e16" midi.bpm="120" place="above" staff="1" tstamp="1" xml:id="tempo01">Allegro</tempo>
                <staff decls="#upper" n="1" xml:id="staff_1308">
                  <layer n="1" xml:id="layer_1314">
                    <note doxml.id="d28e31" dur="2" oct="5" pname="c" tstamp="1" xml:id="note_1320"/>
                    <note doxml.id="d28e33" dur="4" oct="5" pname="e" tstamp="3" xml:id="note_1326"/>
                    <note doxml.id="d28e35" dur="4" oct="5" pname="g" tstamp="4" xml:id="note_1332"/>
                  </layer>
                </staff>
                <staff decls="#lower" n="2" xml:id="staff_1338">
                  <layer n="1" xml:id="layer_1344">
                    <clef doxml.id="d28e39" line="2" shape="G" xml:id="clef_1350"/>
                    <beam xml:id="beam_1356">
                      <note doxml.id="d28e41" dur="8" oct="4" pname="c" tstamp="1" xml:id="note_1362"/>
                      <note doxml.id="d28e43" dur="8" oct="4" pname="g" tstamp="1.5" xml:id="note_1368"/>
                      <note doxml.id="d28e45" dur="8" oct="4" pname="e" tstamp="2" xml:id="note_1374"/>
                      <note doxml.id="d28e48" dur="8" oct="4" pname="g" tstamp="2.5" xml:id="note_1380"/>
                    </beam>
                    <beam xml:id="beam_1386">
                      <note doxml.id="d28e50" dur="8" oct="4" pname="c" tstamp="3" xml:id="note_1392"/>
                      <note doxml.id="d28e52" dur="8" oct="4" pname="g" tstamp="3.5" xml:id="note_1398"/>
                      <note doxml.id="d28e54" dur="8" oct="4" pname="e" tstamp="4" xml:id="note_1404"/>
                      <note doxml.id="d28e56" dur="8" oct="4" pname="g" tstamp="4.5" xml:id="note_1410"/>
                    </beam>
                  </layer>
                </staff>
