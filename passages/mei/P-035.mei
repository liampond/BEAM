                      <note accid.ges="f" doxml.id="d27e7163" dur="16" oct="6" pname="e" tstamp="4.25" xml:id="note_33792"/>
                      <note doxml.id="d27e7165" dur="16" oct="6" pname="d" tstamp="4.5" xml:id="note_33798"/>
