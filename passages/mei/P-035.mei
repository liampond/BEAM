                      <note accid.ges="f" doxml.id="d27e7157" dur="16" oct="5" pname="b" tstamp="3.5" xml:id="note_33768"/>
                      <note doxml.id="d27e7159" dur="16" oct="6" pname="d" tstamp="3.75" xml:id="note_33774"/>
                    </beam>
