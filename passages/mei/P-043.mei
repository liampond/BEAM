  <music>
    <body>
      <mdiv>
        <score>
          <scoreDef key.mode="major" key.pname="d" keysig="2s" meter.count="6" meter.unit="8" optimize="false" xml:id="scoreDef_01">
            <staffGrp bar.thru="true" decls="#instrVoice_1" doxml.id="d27e37" symbol="brace" xml:id="staffGrp_01">
              <staffDef clef.line="2" clef.shape="G" decls="#upper" lines="5" n="1" xml:id="staffDef_P1"/>
              <staffDef clef.line="4" clef.shape="F" decls="#lower" lines="5" n="2" xml:id="staffDef_P2"/>
            </staffGrp>
          </scoreDef>
          <section>
            <measure facs="#zoneOf_m34_k576_001" n="34" xml:id="m34_k576_001">
                <staff decls="#upper" n="1" xml:id="staff_8934">
                  <layer n="1" xml:id="layer_8940">
                    <beam xml:id="beam_8946">
                      <note accid.ges="s" doxml.id="d27e1382" dur="16" oct="4" pname="c" tstamp="1" xml:id="note_8952"/>
