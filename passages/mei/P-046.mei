    <body>
      <mdiv>
        <score>
          <scoreDef key.mode="major" key.pname="c" keysig="0" meter.count="4" meter.sym="common" meter.unit="4" optimize="false" xml:id="scoreDef_01">
            <staffGrp bar.thru="true" decls="#instrVoice_1" doxml.id="d27e35" symbol="brace" xml:id="staffGrp_01">
              <staffDef clef.line="2" clef.shape="G" decls="#upper" keysig="0" lines="5" n="1" xml:id="staffDef_P1"/>
              <staffDef clef.line="4" clef.shape="F" decls="#lower" keysig="0" lines="5" n="2" xml:id="staffDef_P2"/>
            </staffGrp>
          </scoreDef>
          <section>
            <measure facs="#zoneOf_m48_k279_001" n="48" xml:id="m48_k279_001">
                <staff decls="#upper" n="1" xml:id="staff_13788">
                  <layer n="1" xml:id="layer_13794">
                    <rest doxml.id="d27e2651" dur="8" tstamp="1" xml:id="rest_13800"/>
                    <beam xml:id="beam_13806">
                      <note doxml.id="d27e2655" dur="16" oct="5" pname="a" tstamp="1.5" xml:id="note_13812"/>
                      <note accid="n" doxml.id="d27e2657" dur="16" oct="5" pname="b" tstamp="1.75" xml:id="note_13818"/>
                    </beam>
                    <beam xml:id="beam_13824">
                      <note doxml.id="d27e2659" dur="8" oct="6" pname="c" tstamp="2" xml:id="note_13830"/>
                      <note doxml.id="d27e2661" dur="8" oct="6" pname="c" tstamp="2.5" xml:id="note_13836"/>
                    </beam>
                    <note doxml.id="d27e2663" dur="4" oct="6" pname="c" tstamp="3" xml:id="note_13842"/>
                    <note doxml.id="d27e2665" dur="8" oct="5" pname="g" tstamp="4" xml:id="note_13848"/>
                    <rest doxml.id="d27e2667" dur="8" tstamp="4.5" xml:id="rest_13854"/>
                  </layer>
                </staff>
                <staff decls="#lower" n="2" xml:id="staff_13860">
                  <layer n="1" xml:id="layer_13866">
