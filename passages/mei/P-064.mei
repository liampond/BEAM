  <music>
    <body>
      <mdiv>
        <score>
          <scoreDef key.mode="major" key.pname="f" keysig="1f" meter.count="3" meter.unit="4" optimize="false" xml:id="scoreDef_01">
            <staffGrp bar.thru="true" decls="#instrVoice_1" symbol="brace" xml:id="staffGrp_01">
              <staffDef clef.line="2" clef.shape="G" decls="#upper" lines="5" n="1" xml:id="staffDef_P1"/>
              <staffDef clef.line="4" clef.shape="F" decls="#lower" lines="5" n="2" xml:id="staffDef_P2"/>
            </staffGrp>
          </scoreDef>
          <section>
            <measure facs="#zoneOf_m55_k309_002" n="55" xml:id="m55_k309_002">
              <staff decls="#upper" n="1" xml:id="staff_16344">
                <layer n="1" xml:id="layer_16350">
                  <beam xml:id="beam_16356">
                    <note accid="n" dots="1" doxml.id="d27e2831" dur="16" oct="5" pname="b" tstamp="1" xml:id="note_16362"/>
