# Example Environment Variables
# Rename this file to .env and fill in your actual API keys.
# IMPORTANT: Never share your API keys publicly and do not commit them to version control.

# Anthropic Claude API Key
# Get from: https://console.anthropic.com/settings/keys
CLAUDE_API_KEY=sk-ant-...

# OpenAI API Key
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Google Gemini API Key
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=AIza...

# Alibaba Cloud DashScope API Key (Singapore/International region)
# Get from: https://modelstudio.console.alibabacloud.com/?tab=model#/api-key
DASHSCOPE_API_KEY=sk-...
