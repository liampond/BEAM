                        <accid accid="s" xml:id="accid_3996"/>
                      </note>
                      <note doxml.id="d28e50" dur="16" oct="4" pname="a" tstamp="1.75" xml:id="note_3894"/>
                    </beam>
                  </layer>
                </staff>
                <staff decls="#lower" n="2" xml:id="staff_3900">
                  <layer n="1" xml:id="layer_3906">
