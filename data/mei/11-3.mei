      <mdiv n="3" xml:id="mdiv_331003">
        <score xml:id="score_331003">
          <scoreDef key.mode="minor" key.pname="a" keysig="0" meter.count="2" meter.unit="4" optimize="false" xml:id="scoreDef_01">
            <staffGrp bar.thru="true" decls="#instrVoice_1" doxml.id="d28e39" symbol="brace" xml:id="staffGrp_01">
              <staffDef clef.line="2" clef.shape="G" decls="#upper" lines="5" n="1" xml:id="staffDef_P1"/>
              <staffDef clef.line="4" clef.shape="F" decls="#lower" lines="5" n="2" xml:id="staffDef_P2"/>
