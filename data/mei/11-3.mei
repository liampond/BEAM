          <section xml:id="section_allegretto">
            <section xml:id="section_A_m0-8a">
              <pb facs="#surface_24" n="24" xml:id="pb_3846"/>
              <measure facs="#zoneOf_measure1" metcon="false" n="0" xml:id="m0_k331_003">
                <tempo doxml.id="d28e18_d28e25" midi.bpm="128" n="1" staff="1" tstamp="1" type="tempo" xml:id="tempo01">Allegretto </tempo>
                <tempo n="2" place="above" staff="1" tstamp="1" type="heading" xml:id="tempo02">
                  <rend fontstyle="normal" fontweight="normal" halign="center" xml:id="rend_tempo02">ALLA TURCA</rend>
                </tempo>
                <staff decls="#upper" n="1" xml:id="staff_3858">
                  <layer n="1" xml:id="layer_3864">
                    <note doxml.id="d28e41" dur="16" grace="acc" oct="4" pname="b" stem.dir="up" xml:id="note_3870"/>
