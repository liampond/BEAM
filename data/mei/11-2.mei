    <manifestationList label="NMA sources">
      <manifestation label="Autograph score fragment part 1" n="1" xml:id="NMAsource_A">
        <identifier auth="ISM-IDQ">10439</identifier>
        <titleStmt>
          <title xml:lang="DE">Autographe Partitur (NMA Quelle A)</title>
          <title xml:lang="EN">Autograph Score (NMA Source A)</title>
        </titleStmt>
        <biblList>
          <bibl>
            <repository>
              <identifier auth="RISM" auth.uri="https://www.rism.info/" type="library_siglum">A-Sm</identifier>
            </repository>
            <annot n="1" xml:lang="DE">Den Herausgebern war nur dieses Fragment des Autographs bekannt, das die Takte 90&#8211;127 des 3. Satzes umfasst. 2014 wurde ein weiterer Teil des Autographs in H-Bn entdeckt (Signatur Ms. Mus. 15.289), das die Takte 55&#8211;135 des 1. Satzes und die Takte 1&#8211;58 des 2. Satzes enthält. Die übrigen Teile des Autographs (1. Satz T. 1&#8211;54, 2. Satz T. 59&#8211;100, 3. Satz T. 1&#8211;89) müssen weiterhin als verschollen gelten.</annot>
            <annot n="2" xml:lang="EN">The editors were only aware of this fragment of the autograph, which comprises mm. 90&#8211;127 of the 3rd movement. In 2014 another part of the autograph was discovered in H-Bn (call number Ms. Mus. 15.289), containing mm. 55&#8211;135 of the 1st movement and mm. 1&#8211;58 of the 2nd movement. The remaining parts of the autograph (1st mvt. mm. 1&#8211;54, 2nd mvt. mm. 59&#8211;100, 3rd mvt. mm. 1&#8211;89) continue to be considered lost.</annot>
          </bibl>
        </biblList>
        <relationList>
          <relation rel="isEmbodimentOf" target="#expression_K331"/>
        </relationList>
      </manifestation>
